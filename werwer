-- ID выстрела (можно оставить пустым)
local bulletID = "{ddf242a8-c21e-494b-8678-f4bae1e0e5b1}-10967669435"

-- Функция убийства монстра
local function killMonster(monster, humanoid)
    if not monster or not monster.Parent then return false end
    if not humanoid or humanoid.Health <= 0 then return false end
    
    local weapon = getWeapon()
    if not weapon then return false end
    
    -- Огромный урон для гарантированного убийства
    local damage = humanoid.Health * 10 + 99999
    
    local args = {weapon, humanoid, damage, 1, weaponData, damageModifiers, bulletID}
    
    local success = pcall(function()
        damageEvent:InvokeServer(unpack(args))
    end)
    
    if success then
        print("✅ Убит монстр: " .. monster.Name)
    end
    return success
end

-- Функция поиска и убийства всех монстров в папке
local function killAllMonstersInBatch(batchFolder)
    if not batchFolder or not batchFolder.Parent then return end
    
    for _, monster in ipairs(batchFolder:GetChildren()) do
        if monster:IsA("Model") and monster:FindFirstChild("Humanoid") then
            local humanoid = monster.Humanoid
            if humanoid.Health > 0 then
                killMonster(monster, humanoid)
            end
        end
    end
end

-- Отслеживаем новых монстров через ChildAdded
local function setupMonsterTracker(batchFolder)
    batchFolder.ChildAdded:Connect(function(monster)
        task.wait(0.05)  -- Небольшая задержка для инициализации
        if monster:IsA("Model") then
            local humanoid = monster:FindFirstChild("Humanoid")
            if humanoid then
                killMonster(monster, humanoid)
            end
            
            -- Также отслеживаем появление Humanoid внутри монстра
            monster.ChildAdded:Connect(function(child)
                if child.Name == "Humanoid" and child:IsA("Humanoid") then
                    task.wait(0.05)
                    killMonster(monster, child)
                end
            end)
        end
    end)
end

-- Главная функция инициализации
local function initialize()
    -- Ждем появления папки с монстрами
    local generatorBatch = workspace:FindFirstChild("GeneratorMonsterBatch")
    
    if not generatorBatch then
        print("⏳ Ожидание папки GeneratorMonsterBatch...")
        generatorBatch = workspace:WaitForChild("GeneratorMonsterBatch")
    end
    
    print("✅ Найдена папка: GeneratorMonsterBatch")
    
    -- Убиваем всех существующих монстров
    killAllMonstersInBatch(generatorBatch)
    
    -- Настраиваем отслеживание новых монстров
    setupMonsterTracker(generatorBatch)
    
    -- Также отслеживаем появление новых папок (если монстры спавнятся в других местах)
    workspace.ChildAdded:Connect(function(child)
        if child.Name == "GeneratorMonsterBatch" or child:FindFirstChild("Monster") then
            task.wait(0.1)
            if child:FindFirstChild("Monster") then
                killAllMonstersInBatch(child)
            end
            setupMonsterTracker(child)
        end
    end)
    
    print("🔫 Система автоматического убийства монстров активирована!")
end

-- Запускаем с небольшой задержкой
task.wait(1)
initialize()
